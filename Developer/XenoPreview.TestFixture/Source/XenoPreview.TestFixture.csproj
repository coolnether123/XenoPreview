<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>XenoPreview.TestFixture</AssemblyName>
    <RootNamespace>XenoPreview.TestFixture</RootNamespace>
    <Deterministic>true</Deterministic>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Configurations>1.6;1.5;1.4</Configurations>
    <DisableImplicitConfigurationDefines>true</DisableImplicitConfigurationDefines>
    <OutputPath>..\$(Configuration)\Assemblies\</OutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == '1.4'">
    <DefineConstants>XENO_FIXTURE_V1_4;TRACE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == '1.5'">
    <DefineConstants>XENO_FIXTURE_V1_5;XENO_FIXTURE_LUDEON_TK;TRACE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == '1.6'">
    <DefineConstants>XENO_FIXTURE_V1_6;XENO_FIXTURE_LUDEON_TK;TRACE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RimWorldManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(RimWorldManagedDir)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(RimWorldManagedDir)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="XenoPreview">
      <HintPath>$(XenoPreviewAssembly)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <Target Name="ValidateXenoPreviewFixtureConfiguration" BeforeTargets="PrepareForBuild">
    <Error Text="XenoPreview fixture requires Configuration 1.4, 1.5, or 1.6." Condition="'$(Configuration)' != '1.4' And '$(Configuration)' != '1.5' And '$(Configuration)' != '1.6'" />
    <Error Text="XenoPreviewAssembly must point to the exact-version shipping payload." Condition="'$(XenoPreviewAssembly)' == '' Or !Exists('$(XenoPreviewAssembly)')" />
    <Error Text="RimWorldManagedDir must point to the exact-version managed runtime." Condition="'$(RimWorldManagedDir)' == '' Or !Exists('$(RimWorldManagedDir)\Assembly-CSharp.dll')" />
  </Target>
</Project>
